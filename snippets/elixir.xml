<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- Elixir Main Org -->
  <remote name="elixir"
          fetch="https://github.com/Geeky-Works-Here"
          revision="refs/heads/vany" />

  <!-- Elixir Gitlab -->
  <remote name="elixir-gitlab"
          fetch="https://gitlab.com/projectelixiros/"
          revision="refs/heads/vany" />
  
  <!-- Elixir Devices Org -->
  <remote name="elixir-devices"
          fetch="https://github.com/ProjectElixir-Devices"
          revision="A15" />

  <!-- Art -->
  <project path="art" name="android_art" groups="pdk" remote="elixir" revision="vany" clone-depth="1" />
  
  <!-- Rootdir -->

  <!-- Bootable -->
  <project path="bootable/recovery" name="android_bootable_recovery" groups="pdk" revision="vany" remote="elixir" clone-depth="1" />
  
